APP_NAME=Lamp Store Bot
APP_VERSION=0.1.0
DEBUG=true
HOST=127.0.0.1
PORT=8001
DEFAULT_LANGUAGE=pl
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5500,http://localhost:5500,file://
PRODUCT_DB_MODE=mssql

# Baza produktów.
# memory - wbudowane produkty demonstracyjne
# mssql - Microsoft SQL Server przez pyodbc
SQL_SERVER_CONNECTION_STRING=DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost;DATABASE=DiplomaStore;Trusted_Connection=yes;TrustServerCertificate=yes;

# Dostawca AI.
# none - bez zewnętrznego AI, bezpieczne odpowiedzi zapasowe
# grok - xAI Grok API
AI_PROVIDER=grok
GROK_API_KEY=
GROK_MODEL=grok-4-1-fast
GROK_BASE_URL=https://api.x.ai/v1
GROK_TIMEOUT_SECONDS=20
MAX_PRODUCTS_FOR_AI=5
