APP_NAME=Lamp Store Bot
APP_VERSION=0.1.0
DEBUG=true
HOST=127.0.0.1
PORT=8000
DEFAULT_LANGUAGE=ru
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,file://
PRODUCT_DB_MODE=memory

# Product database.
# memory - built-in demo products
# mssql - Microsoft SQL Server through pyodbc
SQL_SERVER_CONNECTION_STRING=DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost;DATABASE=DiplomaStore;Trusted_Connection=yes;TrustServerCertificate=yes;

# AI provider.
# none - no external AI, safe fallback replies
# grok - xAI Grok API
AI_PROVIDER=none
GROK_API_KEY=
GROK_MODEL=grok-4-1-fast
GROK_BASE_URL=https://api.x.ai/v1
GROK_TIMEOUT_SECONDS=20
MAX_PRODUCTS_FOR_AI=5
